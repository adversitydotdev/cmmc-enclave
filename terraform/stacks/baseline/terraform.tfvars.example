# Outputs of stacks/org
account_ids = {
  management  = "111111111111"
  log_archive = "222222222222"
  security    = "333333333333"
  workload    = "444444444444"
  grc         = "555555555555"
}
organization_id      = "o-xxxxxxxxxx"
organization_root_id = "r-xxxx"

# Required by the tag SCP (stacks/org): EC2, EBS and RDS creates are denied without them.
tags = {
  owner               = "it@example.com"
  environment         = "prod"
  data-classification = "cui"
}

# Identity Center users (SCIM-provisioned from Google Workspace) per group.
# group_members = {
#   enclave-admins   = ["alice@example.com"]
#   enclave-auditors = ["bob@example.com"]
# }

# enclave_bucket_arns = ["arn:aws:s3:::example-enclave-bucket"]
# notification_emails = ["security@example.com"]

# Fathom sign-in through Google Workspace (#31). Create the OAuth web client by hand
# (redirect https://<fathom-domain>/v1/auth/oidc/google/callback) and store its
# secret as an SSM SecureString in grc at fathom_oidc_client_secret_parameter.
fathom_oidc_client_id         = "1234567890-abc.apps.googleusercontent.com"
fathom_bootstrap_admin_emails = ["admin@example.com"]
# fathom_certificate_arn = "arn:aws:acm:us-east-1:555555555555:certificate/..."
# fathom_public_url      = "https://fathom.example.com"

# Fathom first-boot seed (#32). Build the artifact from the wizard's rendered ogrl/ with
#   scripts/package-fathom-seed <rendered ogrl dir> seed.tar.gz --library-ref <ogrl_library_ref>
# fathom_seed_bundle_path = "../../../seed.tar.gz"
# ogrl_library_ref        = "5c0987730e2af897d0071cd3826f1c3c4faf8926"

# Fathom read roles (#32). After creating each aws_role connection in Fathom, copy its
# ExternalId here and apply again.
# fathom_read_external_ids = { workload = ["..."], grc = ["..."] }
