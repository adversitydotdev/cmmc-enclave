# Outputs of stacks/org
account_ids = {
  management  = "111111111111"
  log_archive = "222222222222"
  security    = "333333333333"
  workload    = "444444444444"
  grc         = "555555555555"
}
organization_id      = "o-xxxxxxxxxx"
organization_root_id = "r-xxxx"

# Required by the tag SCP (stacks/org): EC2, EBS and RDS creates are denied without them.
tags = {
  owner               = "it@example.com"
  environment         = "prod"
  data-classification = "cui"
}

# Identity Center users (SCIM-provisioned from Google Workspace) per group.
